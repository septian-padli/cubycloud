# Boot-time OS env only (ARCHITECTURE §3.1). Copy to `.env` — the binary does not load this file.
# Production / Docker should set DATA_DIR_PATH=/app/data

PORT=8383
DATA_DIR_PATH=./data

# Environment mode: 'development' or 'production'
ENV=development

# JWT Secret:
# Default: automatically generates and persists a 256-bit secret to $DATA_DIR_PATH/secrets/jwt.key (0600).
# Override: provide a custom secret string (min 32 characters):
# JWT_SECRET=replace-with-a-very-strong-secret-in-production

# Reverse Proxy & HTTPS Configuration:
# Set TRUST_PROXY=true when behind a reverse proxy (Nginx, Caddy, Cloudflare, Traefik) terminating HTTPS.
# TRUST_PROXY=false
# COOKIE_SECURE: force cookie Secure flag true or false. When unset, defaults to false on HTTP and true on HTTPS/trusted proxy.
# COOKIE_SECURE=false

# CORS Allowed Origins:
# In production, defaults to same-origin (the embedded frontend requires no configuration).
# If accessing from external domains, provide comma-separated origins (wildcard * forbidden in production):
# ALLOWED_ORIGINS=https://cloud.example.com
# Storage Master Key Configuration:
# Default mode: auto-generates 256-bit random master key saved to $DATA_DIR_PATH/secrets/master.key (0600 file).
# Override mode: Provide a base64-encoded 32-byte key via env var or file path:
# CUBYCLOUD_MASTER_KEY=base64-encoded-32-byte-key==
# CUBYCLOUD_MASTER_KEY_FILE=/run/secrets/cubycloud_master_key

# Storage Orphan Cleanup Configuration:
# Default mode: Non-destructive dry-run detection/reporting (CUBYCLOUD_STORAGE_CLEANUP_DRY_RUN=true).
# Set to false (or CUBYCLOUD_STORAGE_CLEANUP_ENABLED=true) to enable deletion of confirmed 72h orphans (requires 2 observations).
# CUBYCLOUD_STORAGE_CLEANUP_DRY_RUN=true
