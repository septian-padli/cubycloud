{
  "name": "cubycloud-backend",
  "version": "1.0.0",
  "description": "CubyCloud Backend (Go)",
  "scripts": {
    "dev": "go run ./cmd/server/main.go",
    "build": "go build -o ./bin/cubycloud ./cmd/server/main.go",
    "test": "go test ./... -v",
    "test:coverage": "go test ./... -coverprofile=coverage.out && go tool cover -html=coverage.out",
    "lint": "golangci-lint run",
    "clean": "rm -rf ./bin/ ./data/db/*.db ./data/temp/tus/* ./coverage.out"
  }
}
