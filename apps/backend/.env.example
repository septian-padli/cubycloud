# Server port (default 8383)
PORT=8383

# Data directory path
DATA_DIR_PATH=/app/data

# Environment mode: 'development' or 'production'
ENV=development

# JWT secret key (required in production)
JWT_SECRET=change-me-in-production

# Cookie Secure flag (required to be 'true' in production; in development, supports X-Forwarded-Proto: https or TLS)
COOKIE_SECURE=false

# Allowed CORS origins (comma-separated; required explicit origins in production, e.g. https://cloud.example.com; defaults to * in development)
ALLOWED_ORIGINS=*
